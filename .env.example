# Если пусто, ключ сессий создаётся сам в instance/secret_key
# SECRET_KEY=

# Путь к SQLite. В Docker задан как /data/schedule.db
# DATABASE=

# 1 — наполнить пустую базу учебными примерами. Для рабочей базы оставьте 0.
SEED_DEMO_DATA=0

# 1, когда сайт открыт по HTTPS
COOKIE_SECURE=0
# 1, если приложение стоит за nginx или Caddy
TRUST_PROXY=0

# Локальная отладка: автоперезагрузка. В Docker не используется.
# FLASK_DEBUG=1

# Токен и адрес бота можно задать здесь или на странице установки.
# Переменные окружения важнее значений из страницы установки.
MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
MAX_MINIAPP_URL=
MAX_BOT_USERNAME=
